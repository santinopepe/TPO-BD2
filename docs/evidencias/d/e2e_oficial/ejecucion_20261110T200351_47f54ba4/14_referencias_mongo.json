  "q04": {
    "pipeline": [
      {
        "$group": {
          "_id": "$id_cliente",
          "cantidad": {
            "$sum": 1
          }
        }
      },
      {
        "$match": {
          "cantidad": {
            "$gt": 1
          }
        }
      },
      {
        "$lookup": {
          "from": "clientes",
          "localField": "_id",
          "foreignField": "_id",
          "as": "cliente"
        }
      },
      {
        "$unwind": "$cliente"
      },
      {
        "$project": {
          "_id": 0,
          "id_cliente": "$_id",
          "nombre": "$cliente.nombre",
          "apellido": "$cliente.apellido",
          "cantidad": 1
        }
      },
      {
        "$sort": {
          "cantidad": -1,
          "id_cliente": 1
        }
      }
    ],
