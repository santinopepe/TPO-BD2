# Desde el host; directConnection evita descubrir el hostname interno mongodb.
COMPOSE_PROJECT_NAME=farmared
MONGO_PORT=27017
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
MONGO_URI=mongodb://localhost:27017/?replicaSet=rs0&directConnection=true
MONGO_DB=farmared
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
DB_TIMEOUT_MS=10000
